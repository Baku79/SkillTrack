# ─── JWT ───────────────────────────────────────────
JWT_SECRET=skilltrack_super_secret_jwt_key_change_this

# ─── Email OTP via Gmail (Nodemailer) ──────────────
# 1. Enable 2-Step Verification on your Google account
# 2. Go to: myaccount.google.com/apppasswords
# 3. Create App Password for "Mail" → copy the 16-char code
EMAIL_USER=your_email@gmail.com
EMAIL_PASS=your_gmail_app_password_here

# ─── SMS OTP via Twilio ────────────────────────────
# Sign up free at twilio.com (trial gives ~$15 credit)
# Dashboard → Account SID, Auth Token, Phone Number
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_PHONE=+1234567890

# ─── Server ────────────────────────────────────────
PORT=5000
NODE_ENV=development
